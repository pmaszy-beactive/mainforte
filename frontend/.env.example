# Base URL of the API. Empty = same origin (dev proxy / prod served by the API).
# Capacitor builds set this to the public API origin, e.g. https://mainforte.example.com
VITE_API_URL=

# Stripe Elements publishable key for the billing page's Save Card form. Must match the backend's
# STRIPE_SECRET_KEY (same Stripe account/mode). Vite only reads env files from this directory, not
# the repo root -- without this set here, Save Card silently does nothing (no form, no error).
VITE_PUBLIC_STRIPE_PUBLISHABLE_KEY=
