# --- app ---
APP_ENV=dev
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
APP_PORT=8000
SECRET_KEY=change-me
AUTH_SECRET=change-me
STATE_SECRET=change-me
SUPPORT_USERS=paul@beactive.ai,alice@beactive.ai,kainat@beactive.ai

# --- data (backbone injects DATABASE_URL, REDIS_URL, CELERY_BROKER_URL, CELERY_RESULT_BACKEND at deploy) ---
DATABASE_URL=postgresql://mainforte:mainforte@localhost:5439/mainforte
REDIS_URL=redis://localhost:6390/0
CELERY_BROKER_URL=amqp://mainforte:mainforte@localhost:5679/mainforte
CELERY_RESULT_BACKEND=redis://localhost:6390/1

# --- email ---
SENDGRID_API_KEY=
MAIL_DEFAULT_SENDER=no-reply@mainforte.ai

# --- google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- backbone ---
S3_ENDPOINT=
S3_API_KEY=
S3_SECRET_KEY=
AI_PROXY_BASE_URL=
AI_PROXY_ADMIN_SECRET=
MEETING_BOT_BASE_URL=
MEETING_BOT_API_KEY=
FCM_PROJECT_ID=
# Google service-account JSON (FCM HTTP v1 API), as a single-line string — never a path, matching
# how other JSON/key material in this file is passed inline rather than by file reference.
FCM_SERVICE_ACCOUNT_JSON=
JENKINS_HOST=
JENKINS_PORT=
JENKINS_USERNAME=
# Path to a private key FILE on disk (never the key material itself in an env var) — the
# reconciler reads and chmods a copy per SSH call, same as backbone's jenkins_manager.py.
# If unset, falls back to BASTION_SSH_KEY_PATH (single-key setups, no separate Jenkins key).
JENKINS_SSH_KEY_PATH=
JENKINS_PROVISION_JOB=
JENKINS_DESTROY_JOB=
# Sites feature (separate jobs, same host, so worker-pool and site builds can run in parallel
# instead of queueing behind each other under one job name):
JENKINS_SITE_PROVISION_JOB=
JENKINS_SITE_DESTROY_JOB=
# Admin Postgres credential the site-provision job uses to run bootstrap-db.sh; also forwarded
# to deploy-light.sh (it needs its own connection to the shared backbone state DB even just to
# register HAProxy/NGINX routing). See db_settings.py's db.admin_user/db.admin_password comment.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# --- bastion (jump host the reconciler SSHes through to reach Jenkins) ---
BASTION_HOST=
BASTION_PORT=22
BASTION_USERNAME=
BASTION_SSH_KEY_PATH=
