# Tenant site-template — npm configuration.
#
# This template is standardized on npm (one lockfile format: package-lock.json).
# Do NOT add pnpm-lock.yaml / pnpm-workspace.yaml back here — the per-tenant
# container bakes node_modules from this lockfile at image-build time and only
# installs the incremental delta at runtime.
#
# SUPPLY-CHAIN NOTE (minimumReleaseAge): the previous pnpm-workspace.yaml set
# `minimumReleaseAge: 1440` (refuse npm package versions published <1 day ago)
# as a defense against supply-chain attacks. npm has no native equivalent, so
# that automatic guard is gone on the tenant side. Mitigations that remain:
#   - tenant deps are baked from this committed, pinned package-lock.json at
#     image-build time (npm ci honors exact resolved versions), so a tenant
#     boot never pulls a fresh/untrusted version on its own;
#   - the lockfile is reviewed/committed deliberately, so a new version only
#     enters after a human-reviewed lockfile change.
# When bumping deps, prefer waiting out the 1-day window (or `npm install
# <pkg> --before <date>`) before committing the updated lockfile.
auto-install-peers=false
